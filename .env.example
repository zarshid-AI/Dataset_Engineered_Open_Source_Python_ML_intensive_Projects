# ════════════════════════════════════════════════════════════
#  GitHub ML/AI Model Scanner — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════

# ── GitHub API Tokens ──────────────────────────────────────
# Primary token used for the Search API (lower rate limit)
GITHUB_SEARCH_TOKEN=ghp_YOUR_SEARCH_TOKEN_HERE

# Core API tokens for parallel enrichment (comma-separated)
GITHUB_CORE_TOKENS=ghp_CORE_TOKEN_1,ghp_CORE_TOKEN_2

# ── Ollama / LLM Judge ─────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gpt-oss:120b

# ── Logging ────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Pipeline ───────────────────────────────────────────────
# Repositories analysed in parallel in Steps 2 and 4 (each needs up to ~700 MB RAM)
SCANNER_WORKERS=2

# Short folder for temporary clones (Windows: keeps paths under 260 characters).
# Default: <system temp>\ppoem
# PPOEM_TEMP_DIR=C:\ppoem
